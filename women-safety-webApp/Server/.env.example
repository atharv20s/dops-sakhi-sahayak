# ==========================================
# Sakhi Sahayak - Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env with actual keys to git!
# ==========================================

PORT=5001

# Sarvam AI (Speech-to-Text / TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# OpenRouter / LLM
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Emergency Notifications
RESEND_API=your_resend_api_key_here
FAST2SMS_API_KEY=your_fast2sms_api_key_here
EMERGENCY_EMAIL=emergency_alert@example.com
EMERGENCY_PHONE=919999999999

# Twilio (Optional SMS/Voice)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AWS Configuration (Used by S3 Evidence Uploads)
AWS_REGION=ap-south-1
S3_EVIDENCE_BUCKET=your_s3_bucket_name_here

# Redis (For Multi-node Socket.io scaling in Production)
# REDIS_URL=redis://<elasticache-redis-cluster>:6379

# Database Connection (AWS RDS PostgreSQL)
# Runtime application role (CRUD only):
# DATABASE_URL=postgresql://sakhi_app:<APP_PASSWORD>@<RDS_ENDPOINT>:5432/sakhi_production?schema=public&sslmode=require
# Migration role (schema changes only during deployment):
# DIRECT_URL=postgresql://sakhi_migrator:<MIGRATION_PASSWORD>@<RDS_ENDPOINT>:5432/sakhi_production?schema=public&sslmode=require

# Legacy MongoDB Connection (Deprecated — migrating to PostgreSQL)
# MONGO_URI=mongodb://<cluster-url>:27017/sakhi?retryWrites=true&w=majority
